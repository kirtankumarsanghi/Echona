# ------------------------------------------
# ECHONA Frontend � Environment Variables
# ------------------------------------------

# Google OAuth Client ID (same as backend's GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Enable Google SDK on localhost only after adding localhost origin in Google Cloud Console
VITE_ALLOW_LOCALHOST_GOOGLE=false

# Backend API URL (leave empty to use Vite proxy in dev)
VITE_API_URL=
